{
  "name": "visual-editor-sdk",
  "version": "0.1.4",
  "description": "A secure, framework-agnostic SDK for selecting and preview-editing registered website content from a parent visual editor.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["visual-editor", "website-editor", "postmessage", "content-editing", "sdk"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "happy-dom": "^15.11.7"
  }
}